# Variables de entorno del frontend (MANIFEST_FRONTEND §2.3, AP-F8).
#
# Solo las variables con prefijo NEXT_PUBLIC_ se exponen al bundle del navegador.
# Cualquier secreto (tokens, claves HMAC) DEBE vivir en variables server-only con
# prefijo FRONTEND_ y NUNCA exponerse con NEXT_PUBLIC_.

# URL base del API (expuesta al cliente).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Ejemplo de variable server-only (NO expuesta al navegador):
# FRONTEND_API_TOKEN=
