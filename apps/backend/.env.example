# Configuración del motor de IA (Fase 4). Copia este archivo a `.env` y
# rellena los valores reales. `.env` está gitignoreado: nunca se commitean
# secretos (A8).

# Requerido. API key de OpenAI. Nunca commitear la real: `.env` está gitignoreado.
OPENAI_API_KEY=

# Requerido. Alias del modelo; se persiste en `Analysis.model`.
OPENAI_MODEL=gpt-4o-mini

# Snapshot fechado del modelo (trazabilidad, `Analysis.model_version`).
# Si se omite, cae al alias de OPENAI_MODEL.
OPENAI_MODEL_VERSION=gpt-4o-mini-2024-07-18

# Opcional. Base URL alternativa (proxy/Azure). Vacío = api.openai.com.
OPENAI_BASE_URL=

# --- HTTP API (Fase 5.0) ---
# Requerido por `cmd/api` y `cmd/migrate`. Cadena de conexión de Postgres.
# El puerto 5433 corresponde al docker-compose de desarrollo (ops/docker/).
APP_DATABASE_URL=postgres://langlint:langlint@localhost:5433/langlint?sslmode=disable

# Opcional. Dirección de escucha del API. Por defecto `:8080`.
APP_HTTP_ADDR=:8080

# Requerido por `cmd/api`. Identidad del usuario único del MVP (UUID v7); el
# contrato no tiene autenticación (PRODUCT_DOMAIN §3.2).
APP_USER_ID=0192f3a0-0000-7000-8000-000000000000

# Requerido por `cmd/api`. Email del usuario único; se devuelve en la
# exportación de datos A9 (`GET /me/data/export`).
APP_USER_EMAIL=student@example.com

# Opcional. Timeout de la llamada al LLM (Go duration). Por defecto `60s`.
APP_LLM_TIMEOUT=60s

# Opcional. Orígenes (CORS) autorizados a llamar al API desde el navegador,
# separados por comas. Por defecto `http://localhost:3000` (dev del frontend).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requerido por `cmd/api` y `cmd/provisioner`. Secreto del HMAC-SHA256 con el
# que se pseudonimizan los identificadores antes de materializar analytics (A8).
# Genera uno aleatorio, p. ej.: openssl rand -hex 32
APP_PSEUDONYM_SECRET=change-me-to-a-long-random-secret

# --- Provisioner (Fase 6) ---
# Opcional. Días de retención de datos crudos de práctica antes de que el job
# `purge-raw-data` los borre físicamente (A8). Por defecto `30`.
APP_RAW_RETENTION_DAYS=30

# Opcional. Días de gracia antes de que el job `execute-deletions` materialice
# el derecho al olvido (A9). Por defecto `30`.
APP_DELETION_GRACE_DAYS=30
